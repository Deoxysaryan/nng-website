# Public URL of the deployed site. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# Set to "true" at launch to allow search engines in. Anything else keeps every page noindex.
SITE_INDEXABLE=false

# WhatsApp number, international format, digits only (for example 919876543210).
# Leave empty in demos so no click messages a real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# A static copy for a host without a Node server, such as GitHub Pages:
# NEXT_EXPORT=1 next build writes ./out. Set the base path when the copy is served from a sub-path.
# The preview note shows as a thin banner above the header, so a copy shared for review is not
# mistaken for the live site.
NEXT_EXPORT=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PREVIEW_NOTE=

# Optional analytics and Search Console verification.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
